PORT=5000
NODE_ENV=development
API_VERSION=v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Admin panel accounts (created with: npm run seed)
ADMIN_EMAIL=your_email@gmail.com
ADMIN_PASSWORD=change_this_password
EDITOR_EMAIL=your_email@gmail.com
EDITOR_PASSWORD=change_this_password
STAFF_EMAIL=your_email@gmail.com
STAFF_PASSWORD=change_this_password

DATABASE_URL="postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE_NAME?schema=public"

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRES_IN=7d

RESET_PASSWORD_EXPIRES_MS=3600000

MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Nova Tech <noreply.novatech@gmail.com>"
