PORT=5000
NODE_ENV=development
API_VERSION=v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Admin panel accounts (created with: npm run seed)
ADMIN_EMAIL=admin@novatech.com
ADMIN_PASSWORD=password123
EDITOR_EMAIL=editor@novatech.com
EDITOR_PASSWORD=password123
STAFF_EMAIL=staff@novatech.com
STAFF_PASSWORD=password123

DATABASE_URL="postgresql://postgres:9898@localhost:5433/nova_tech?schema=public"

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRES_IN=7d

RESET_PASSWORD_EXPIRES_MS=3600000

MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@novatech.com
SMTP_PASS=password123
EMAIL_FROM="Nova Tech <noreply.novatech@gmail.com>"
